@startuml
left to right direction
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultFontName DejaVu Sans
skinparam ranksep 30
skinparam nodesep 20
skinparam wrapWidth 220

package "Fuente oficial" as p_fuente {
  [Paquete CVN\n(XSD + XML oficiales)] as fuente
}

package "Generacion y normalizacion\n(src/generated/, src/cvn_codegen/)" as p_capa1 {
  [Bindings estructurales\nMetadatos normalizados\nPolitica semantica conservadora] as capa1
}

package "Dominio y formato\n(src/models/cvn/, schemas/, src/open_cvn/)" as p_capa2 {
  [Modelos de dominio\nModelo conceptual agnostico\n(notacion UML)\nJSON Schema + Open CVN JSON\nParser y validador] as capa2
}

package "Herramienta local\n(src/open_cvn_app/)" as p_app {
  [Almacenamiento, versionado\ny exportacion] as app
}

fuente --> capa1 : generacion\nreproducible (xsdata)
capa1 --> capa2
capa2 --> app
@enduml
